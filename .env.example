# Application
APP_NAME="Inventário de Ativos de TI"
APP_VERSION="1.0.0"
DEBUG=false

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/inventario_ti
DATABASE_URL_TEST=postgresql+psycopg://postgres:postgres@localhost:5432/inventario_ti_test

# Security
SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Upload
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=5242880

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# Admin padrão (criado na primeira execução)
FIRST_ADMIN_EMAIL=admin@empresa.com
FIRST_ADMIN_PASSWORD=Admin@123
FIRST_ADMIN_NAME=Administrador
